<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Swachh Sena</title>
    <link rel="icon" href="/assets/logo-eng.png" type="image/png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="<%= language === 'mr' ? '/assets/logo-mr.png' : '/assets/logo-eng.png' %>" alt="Logo" height="50" class="me-2">
                <%= t('Swachh Sena') %>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link <%= title === 'Garbage Reporting System' ? 'active' : '' %>" href="/"><%= t('Home') %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= title === 'Report Garbage' ? 'active' : '' %>" href="/report"><%= t('Report Garbage') %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= title === 'View Reports' ? 'active' : '' %>" href="/reports"><%= t('View Reports') %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= title === 'Our Work' ? 'active' : '' %>" href="/our-work"><%= t('Our Work') %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= title === 'Donate' ? 'active' : '' %>" href="/donate"><%= t('Donate') %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/login"><%= t('Admin Login') %></a>
                    </li>
                    <li class="nav-item d-flex align-items-center ms-2">
                        <select class="form-select form-select-sm" id="languageSelector" style="width: auto; background-color: rgba(255,255,255,0.2); color: white; border-color: white; border-radius: 20px; padding: 5px 15px; font-weight: 500; appearance: none; -webkit-appearance: none; -moz-appearance: none; background-image: none;">
                            <option value="en" <%= language === 'en' ? 'selected' : '' %> style="background-color: #198754; color: white;">English</option>
                            <option value="mr" <%= language === 'mr' ? 'selected' : '' %> style="background-color: #198754; color: white;">मराठी</option>
                        </select>
                    </li>
                    <li class="nav-item d-flex align-items-center">
                        <button type="button" class="btn btn-outline-light" id="themeToggle">
                            <i class="fas fa-moon" id="themeIcon"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>