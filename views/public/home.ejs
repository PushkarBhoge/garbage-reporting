        <div class="col-md-4 text-center mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3>✅ Clean</h3>
                    <p>Teams clean the area and upload after photos</p>
                </div>
            </div>
        </div>
    </div>
    
