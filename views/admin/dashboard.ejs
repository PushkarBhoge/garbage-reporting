<%- include('../partials/admin-header') %>

<div class="container my-5">
    <h2>Admin Dashboard</h2>
    
    <div class="row mt-4">
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5>Total Reports</h5>
                    <h2><%= stats.totalReports %></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h5>Pending</h5>
                    <h2><%= stats.pendingReports %></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5>Assigned</h5>
                    <h2><%= stats.assignedReports %></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5>Cleaned</h5>
                    <h2><%= stats.cleanedReports %></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-dark text-white">
                <div class="card-body">
                    <h5>Total Blogs</h5>
                    <h2><%= stats.totalBlogs %></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <h5>Subscribers</h5>
                    <h2><%= stats.totalSubscribers %></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body">
                    <h5>Total Donations</h5>
                    <h2>₹<%= Math.round(stats.totalDonations).toLocaleString() %></h2>
                    <small><%= stats.donationCount %> donations</small>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <!-- <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5>Quick Actions</h5>
                    <a href="/admin/reports" class="btn btn-primary me-2">Manage Reports</a>
                    <a href="/admin/teams" class="btn btn-success me-2">Manage Teams</a>
                    <a href="/admin/reports-download" class="btn btn-info">Download Reports</a>
                </div>
            </div>
        </div> -->



        <div class="col-12 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body text-center text-md-start">
                    <h5 class="mb-3">Quick Actions</h5>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-start flex-wrap">
                        <a href="/admin/reports" class="btn btn-primary flex-fill flex-md-grow-0">Manage Reports</a>
                        <a href="/admin/teams" class="btn btn-success flex-fill flex-md-grow-0">Manage Teams</a>
                        <a href="/admin/blogs" class="btn btn-dark flex-fill flex-md-grow-0">Manage Blogs</a>
                        <a href="/admin/subscribers" class="btn btn-secondary flex-fill flex-md-grow-0">Manage Subscribers</a>
                        <a href="/admin/donations" class="btn btn-purple flex-fill flex-md-grow-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">View Donations</a>
                        <a href="/admin/reports-download" class="btn btn-info flex-fill flex-md-grow-0">Download Reports</a>
                    </div>
                </div>
            </div>
        </div>




        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5>Teams</h5>
                    <p>Total Teams: <strong><%= stats.totalTeams %></strong></p>
                    <a href="/admin/teams" class="btn btn-outline-primary">View Teams</a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>